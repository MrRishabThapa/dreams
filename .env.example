# Supabase sync. Copy to .env.local and fill in. .env.local is gitignored: never commit it.
# Both values are public by design (they ship in the app). Use the PUBLISHABLE key (sb_publishable_…),
# never the secret/service-role key or the database password.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
