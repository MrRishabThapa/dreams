{
  "name": "dreams",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "scripts/webkit-env.sh playwright test",
    "icons": "scripts/make-icons.sh",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name dreams",
    "demo": "node scripts/demo-year.mjs > demo-backup.json"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.79.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.7",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
