# Cloudflare Pages headers. The CSP mirrors the <meta> tag in index.html.
# %SUPABASE_ORIGIN% is filled from VITE_SUPABASE_URL at build time (vite.config.ts).
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' %SUPABASE_ORIGIN%; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY

# Never cache the entry points, so "Update available" always finds the new build.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Hashed build assets never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
